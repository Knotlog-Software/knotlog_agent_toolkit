{
  // Shared MCP server configurations for the Knotlog team.
  // The install.sh script can merge these into your opencode.jsonc.
  //
  // To add a new server: add an entry below, then run ./install.sh to merge.
  // To disable a server: set "enabled": false.

  "mcp": {
    // Filesystem access for reading/writing project files
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "."],
      "enabled": true,
      "timeout": 5000
    },

    // GitHub integration (official remote server, PAT auth).
    // Requires GITHUB_PERSONAL_ACCESS_TOKEN in your environment:
    //   export GITHUB_PERSONAL_ACCESS_TOKEN=$(gh auth token)
    // Toolsets are limited to keep the tool list (and context) small.
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}",
        "X-MCP-Toolsets": "context,repos,issues,pull_requests,actions,users"
      },
      "timeout": 30000
    }

    // Add your MCP servers below. Examples:

    // PostgreSQL database access
    // "postgres": {
    //   "type": "local",
    //   "command": ["npx", "-y", "@modelcontextprotocol/server-postgres", "{env:DATABASE_URL}"],
    //   "enabled": false,
    //   "timeout": 5000
    // },

    // Slack integration
    // "slack": {
    //   "type": "local",
    //   "command": ["npx", "-y", "@modelcontextprotocol/server-slack"],
    //   "environment": { "SLACK_BOT_TOKEN": "{env:SLACK_BOT_TOKEN}" },
    //   "enabled": false,
    //   "timeout": 5000
    // }
  }
}
